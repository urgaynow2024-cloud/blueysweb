NEXT_PUBLIC_SUPABASE_URL=https://qxphnlcqqdhoavtuzbnt.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_rQXT5Z4wndmPw2vkh2kYQw_j9zaq37R

# Required for admin writes (portfolio uploads, content saves, queue management,
# review moderation, adoptables, etc.). Get from Supabase Dashboard → Project Settings → API.
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# Optional: auto-runs supabase/schema.sql on first visit if the database is empty.
# Get from https://app.supabase.com/account/tokens (needs "database" scope, which is default).
# SUPABASE_ACCESS_TOKEN=your_management_api_token_here

# Admin owner login password (override the default "blueyadmin").
ADMIN_PASSWORD=blueyadmin

# Optional but strongly recommended: a dedicated long random string used to sign
# admin session cookies (HMAC-SHA256).
# If unset, SUPABASE_SERVICE_ROLE_KEY is used as the signing secret.
# If BOTH are missing, login fails closed with a 500 instead of using a default.
# Generate with: openssl rand -base64 48
SESSION_SECRET=your_long_random_session_secret_here

# Optional: Discord webhook used to announce new commission requests.
# A live webhook token was previously committed to this repository in
# src/app/api/commission/route.ts. It MUST be rotated in Discord
# (Server Settings -> Integrations -> Webhooks), because it remains in git
# history even though it has been removed from the source.
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/YOUR_ID/YOUR_TOKEN